# ═══════════════════════════════════════════════════════════
# StoryForge AI — Netlify Environment Variables
# Add ALL of these in:
# Netlify Dashboard → Your Site → Site Configuration → Environment Variables
# ═══════════════════════════════════════════════════════════

# ── 1. ANTHROPIC (Required — stories won't generate without this) ─────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── 2. PAYPAL SANDBOX ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=YOUR_WEBHOOK_ID

# ── 3. PRINTIFY ───────────────────────────────────────────────────────────────
PRINTIFY_API_KEY=YOUR_PRINTIFY_API_KEY
PRINTIFY_SHOP_ID=YOUR_SHOP_ID
PRINTIFY_PROVIDER_ID=26
PRINTIFY_BLUEPRINT_SOFTCOVER=YOUR_SOFTCOVER_BLUEPRINT_ID
PRINTIFY_BLUEPRINT_HARDCOVER=YOUR_HARDCOVER_BLUEPRINT_ID
PRINTIFY_VARIANT_SOFTCOVER=YOUR_SOFTCOVER_VARIANT_ID
PRINTIFY_VARIANT_HARDCOVER=YOUR_HARDCOVER_VARIANT_ID

# ── 4. EMAIL via smtp2go (free) ───────────────────────────────────────────────
SMTP2GO_API_KEY=YOUR_SMTP2GO_API_KEY
EMAIL_FROM=StoryForge AI <yourname@gmail.com>
